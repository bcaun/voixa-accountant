# Copy to .env (or set in your hosting panel). Only DATABASE_URL and APP_URL are required.

DATABASE_URL=postgres://voixa:voixa@localhost:5432/voixa
APP_URL=http://localhost:3000            # public address; https:// turns on secure cookies
PORT=3000
FIRM_NAME=Voixa Accounting
TRUST_PROXY=0                            # 1 when running behind a reverse proxy / load balancer

# Files: "fs" (local disk) or "s3" (AWS S3, Cloudflare R2, Google Cloud Storage, MinIO)
STORAGE_DRIVER=fs
STORAGE_DIR=./data/files
# S3_BUCKET=voixa-exchange
# S3_REGION=eu-south-2
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2 / MinIO only
# S3_FORCE_PATH_STYLE=0                                    # 1 for MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# Email: "console" prints emails to the log, "smtp" uses SMTP_URL, "postmark" uses the Postmark API
# (Postmark adds delivery, bounce, spam-complaint and open tracking via the webhook below).
MAIL_TRANSPORT=console
MAIL_FROM=Voixa Exchange <exchange@voixa.es>
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# POSTMARK_TOKEN=
# POSTMARK_STREAM=outbound
# Webhook URL to set in Postmark: https://<your host>/webhooks/postmark?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Reminders and recurring deadlines
SCHEDULER=on
SCHEDULER_INTERVAL_MIN=10
REMINDER_UNOPENED_HOURS=48
REMINDER_UNCONFIRMED_HOURS=72
REMINDER_REPEAT_HOURS=48
MAX_AUTO_REMINDERS=3

# Automatic reading of bank statements and invoices.
# Norma 43, camt.053 and CSV statements are parsed without any external service.
# PDFs and photos (statements and invoices) are read with Claude and need an Anthropic API key.
# ANTHROPIC_API_KEY=
RECOGNITION_AI=on                        # off: never send files to the AI reader
RECOGNITION_MODEL=claude-opus-5-5
RECOGNITION_MAX_AI_MB=20
