# HTTPS certificates are issued and renewed automatically by Let's Encrypt.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy app:3000
}

# Product website: static files built by `node site/build.mjs` into site/public.
{$SITE_DOMAIN:pescada.io} {
	encode zstd gzip
	root * /srv/site
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# the demo form posts to the app; Cloudflare Web Analytics (cookieless) is allowed for when it is switched on
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; form-action https://{$DOMAIN}"
	}
	# pages are always checked for a newer version; the stylesheet is linked with a content hash, so it can be kept
	@pages not path /fonts/* /favicon.svg /styles.css
	header @pages Cache-Control "no-cache"
	header /styles.css Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /favicon.svg
	header @static Cache-Control "public, max-age=2592000"
	handle_errors {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

www.{$SITE_DOMAIN:pescada.io} {
	redir https://{$SITE_DOMAIN:pescada.io}{uri} permanent
}
